# Groq Cloud API Key (Get free instant API key at https://console.groq.com)
GROQ_API_KEY=

# Production: the public address of the site, used for share previews, the canonical
# link and the sitemap. Leave unset locally.
# SITE_URL=https://your-space.hf.space

# Optional backup key. Used when Groq rejects the primary (revoked, expired, typo)
# or rate-limits it. Groq's limits are per organization, so a backup from the same
# org only covers a bad key; for more capacity it needs to be on a different plan.
# GROQ_API_KEY_BACKUP=

# Optional: override the answer model (default openai/gpt-oss-120b).
# Groq retires models, so check https://console.groq.com/docs/models if answers fall back to quotes.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: model for background whole-video summaries (default openai/gpt-oss-20b),
# and its tokens-per-minute cap (default 8000, Groq's free tier). Raise the cap on a paid plan.
# GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
# GROQ_SUMMARY_TPM=8000


# Public-site limits (defaults shown). See "Public use and limits" in the README.
# RATE_LIMIT_INGEST_PER_HOUR=5
# RATE_LIMIT_SEARCH_PER_10_MIN=30
# MAX_VIDEO_MINUTES=60
# MAX_CONCURRENT_INGESTS=2
# MAX_QUEUED_SUMMARIES=3
# MAX_CACHED_VIDEOS=20

# How many proxies sit in front of the app and append to X-Forwarded-For (default 1).
# Rate limits use the address the last trusted proxy saw; raise this if your host chains more.
# TRUSTED_PROXY_HOPS=1

# Local only, for curating featured videos: also save pasted videos to data/.
# Never set this on a public server.
# SCRUBCAST_SAVE_LIBRARY=1
