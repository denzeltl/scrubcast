# Groq Cloud API Key (Get free instant API key at https://console.groq.com)
GROQ_API_KEY=

# Optional: override the answer model (default openai/gpt-oss-120b).
# Groq retires models, so check https://console.groq.com/docs/models if answers fall back to quotes.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: model for background whole-video summaries (default openai/gpt-oss-20b),
# and its tokens-per-minute cap (default 8000, Groq's free tier). Raise the cap on a paid plan.
# GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
# GROQ_SUMMARY_TPM=8000
